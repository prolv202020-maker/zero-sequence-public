      "name": "灰翎蜕蛾",
      "type": "魔物",
      "region": "北线林地",
      "first": 35,
      "vol": 4,
      "ch": 5,
      "summary": "飞膜似灰羽的小型群居虫类，可干扰行者辨别方向。",
      "level": [
        {
          "at": 35,
          "text": "Lv.12：北线林地实测。"
        }
      ],
      "habitats": [
        {
          "at": 35,
          "text": "维兰德北线、第三路碑周围的林地及蜕蛾巢群。"
        }
      ],
      "skills": [
        {
          "at": 35,
          "text": "方向干扰：虫群活动时会扰乱方位判断。"
        },
        {
          "at": 35,
          "text": "声音重组：翅膜发出的声响类似曾听过的车轮与铃声。"
        }
      ],
      "habits": [
        {
          "at": 35,
          "text": "暗红腹斑的个体被本地人识别为产卵雌虫。"
        },
        {
          "at": 35,
          "text": "若杀伤产卵雌虫，可能触发其他个体集中攻击巢穴周围活物。"
        }
      ],
      "tactics": [
        {
          "at": 35,
          "text": "避免直接攻击繁殖巢；使用轻微雷光分散虫群，沿背风坡退离。"
        },
        {
          "at": 35,
          "text": "不要完全依赖视觉方向，用脚步、地面标记和队友互相校验路线。"
        }
      ],
      "observations": [],
      "sources": [
        {
          "at": 35,
          "vol": 4,
          "ch": 5
        },
        {
          "at": 43,
          "vol": 5,
          "ch": 3
        }
      ]
    },
