        }
      ],
      "habits": [
        {
          "at": 48,
          "text": "遇到受困或受伤情况会反复冲撞出口；个体可能试图返回旧巢道。"
        }
      ],
      "tactics": [
        {
          "at": 48,
          "text": "狭窄矿道尽量保留撤离通道，避免将两头大型个体夹在队伍前后。"
        },
        {
          "at": 48,
          "text": "利用观察到的转向停顿和受伤肢体寻找躲避时机，不强行拼破甲。"
        }
      ],
      "observations": [
        {
          "at": 48,
          "text": "观察到的受伤前足被生锈金属支架缠绕；不能据此断言所有个体有相同弱点。"
        }
      ],
      "sources": [
        {
          "at": 48,
          "vol": 5,
          "ch": 8
        }
      ]
    },
    {
      "id": "foghoof-deer",
      "name": "雾蹄巨鹿",
      "type": "魔物",
      "region": "西境商路",
      "first": 59,
      "vol": 6,
      "ch": 9,
      "summary": "巨大的鹿角与灰白雾气并存，但雾的规则来源仍未得到证实。",
      "level": [
        {
          "at": 59,
          "text": "Lv.21：西境山谷观测。"
        }
      ],
      "habitats": [
        {
          "at": 59,
          "text": "失落商道附近的溪谷、旧桥石坡与山林。"
        }
      ],
      "skills": [
        {
          "at": 59,
          "text": "沉重踏击：体型巨大，受惊抬蹄足以将前排战士震退。"
        },
        {
          "at": 59,
          "text": "鹿角摆动：转头可伴随气流变化，使附近人员失去平衡；机制未完全确认。"
        }
      ],
      "habits": [
        {
          "at": 59,
          "text": "个体为解除后腿铁网并寻找水源而接近村落，并非主动猎杀行人。"
        },
        {
          "at": 59,
          "text": "解除缠绕后返回山林，沿旧石道方向移动。"
        }
      ],
      "tactics": [
        {
          "at": 59,
          "text": "避免堵住其前往水源的路线，先设置村民隔离线。"
        },
        {
          "at": 59,
          "text": "查清是否受困或受伤，必要时保持安全距离进行非致命救援。"
        }
      ],
      "observations": [
        {
          "at": 59,
          "text": "灰白雾气与地形光线异常可能并存；不能直接把所有现象认定为巨鹿的技能。"
        }
      ],
      "sources": [
        {
          "at": 59,
          "vol": 6,
          "ch": 9
        }
      ]
