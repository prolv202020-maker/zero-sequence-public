    {
      "id": "blackcarapace-hunter",
      "name": "黑甲猎虫",
      "type": "魔物",
      "region": "灰石矿道",
      "first": 16,
      "vol": 2,
      "ch": 6,
      "summary": "坚硬甲壳、前肢锋利，擅长在复杂地形及群体混战中造成威胁。",
      "level": [
        {
          "at": 44,
          "text": "Lv.11：灰石矿井观测个体。"
        },
        {
          "at": 75,
          "text": "Lv.16：维兰德东郊虫群前列个体；不是全种族固定等级。"
        }
      ],
      "habitats": [
        {
          "at": 16,
          "text": "晨星镇附近伐木营地的仓房周围。"
        },
        {
          "at": 44,
          "text": "灰石矿道的裂缝、土孔与旧巢道。"
        },
        {
          "at": 75,
          "text": "维兰德东郊低地与湿泥土坡，存在多处虫孔。"
        }
      ],
      "skills": [
        {
          "at": 16,
          "text": "甲壳防护：普通武器正面攻击难以破防。"
        },
        {
          "at": 16,
          "text": "前肢刺击与扑击：能从棚顶突袭，试图击穿目标肩部。"
        },
        {
          "at": 16,
          "text": "战术转向：个别个体越过前排，直接攻击后方治疗者。"
        },
        {
          "at": 75,
          "text": "泥地突袭：可从湿泥与地下孔洞中突然跃起。"
        }
      ],
      "habits": [
        {
          "at": 17,
          "text": "营地作战中个体分工异常，队伍记录「疑似被指挥」，原因未证实。"
        },
        {
          "at": 46,
          "text": "土孔与地底通路互联；移动原因（例如气味、水流）仍属猜测。"
        },
        {
          "at": 75,
          "text": "可能受散落谷物与湿土气味吸引，曾聚集围攻药剂商队。"
        }
      ],
      "tactics": [
        {
          "at": 16,
          "text": "优先攻击足部、关节及甲壳连接缝；细雷从裂缝导入曾有效。"
        },
        {
          "at": 44,
          "text": "矿井内谨防坍塌与粉尘，不宜深入虫巢追击。"
        },
        {
          "at": 75,
          "text": "防备侧翼土孔与第二波虫群，撤离路线比追杀单体更重要。"
        }
      ],
      "observations": [
        {
          "at": 30,
          "text": "旧账册中存在「黑甲猎虫壳」的采购记录，具体掉率未公开。"
        }
      ],
      "sources": [
        {
